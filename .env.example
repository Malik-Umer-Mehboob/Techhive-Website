# Copy to `.env` (gitignored) and fill in. Never commit real secrets.
#
# The Lead store. The same libSQL driver runs in dev and prod; only these two
# values change the target.
#
# - Local dev/test: leave BOTH unset. The client falls back to a local
#   `file:local.db` SQLite file. No Turso account needed.
# - Production: point at the provisioned Turso database.
#
#   DATABASE_URL          The Turso database URL, e.g. libsql://<db>-<org>.turso.io
#                         (`turso db show <db> --url`).
#   DATABASE_AUTH_TOKEN   The Turso *database* auth token, a per-database JWT
#                         from `turso db tokens create <db>`. This is NOT the
#                         Turso *platform* API token (`turso auth token`), which
#                         only authenticates the management API/CLI and will be
#                         rejected by the database connection.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Lead email notifications (Resend). Leave unset to skip sending in dev; a
# persisted Lead still succeeds. See src/lib/leads/notifier.ts.
RESEND_API_KEY=
